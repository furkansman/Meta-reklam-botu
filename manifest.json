{
  "manifest_version": 3,
  "name": "Meta Reklam Botu",
  "version": "0.6.0",
  "description": "Meta reklam araştırmaları için tarama, geçmiş ve rakip takip paneli.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_title": "Meta Reklam Botu",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "ad-data.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://api.telegram.org/*"
  ]
}
